# nvim
alias vim="nvim"

# ls
alias ls='lsd'
alias l='lsd -l'
alias la='lsd -a'
alias lla='lsd -la'
alias ll='lsd -la'
alias lt='lsd --tree'

# claude yolo mode: prefer declawd if installed, else raw claude
yolo() {
    if command -v declawd >/dev/null 2>&1; then
        declawd --yolo "$@"
    else
        claude --dangerously-skip-permissions "$@"
    fi
}

# quick-capture a link/doc into the right project hub via the /capture command.
# runs from the vault so the command and its globs resolve. opens interactively
# with the command pre-seeded so you can answer its follow-ups (hub choice,
# Todoist task); use `capture -p ...` args style by editing to `claude -p` for
# pure fire-and-forget.
capture() {
    ( cd "$HOME/vault" && claude "/capture $*" )
}

# handle un-graceful exit of ssh sessions that leave the mouse in a weird state
alias ssh="ssh-clean-mouse"
ssh-clean-mouse() {
    command ssh "$@"
    printf '\e[?1000l\e[?1006l\e[?1004l'
}

