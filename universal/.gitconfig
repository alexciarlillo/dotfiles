[alias]
  ca = commit --amend --reuse-message=HEAD
	clone-wt = "!bash $HOME/.local/bin/clone-for-wt"
	clean-wt = "!bash $HOME/.local/bin/clean-merged-wt"
  ds = !git diff | delta --side-by-side
  du = !git diff | delta

[filter "lfs"]
	process = git-lfs filter-process
	required = true
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f

[url "https://"]
    insteadOf = git://

# https://blog.gitbutler.com/how-git-core-devs-configure-git
[column]
  ui = auto
[branch]
        sort = -committerdate
[tag]
        sort = version:refname
[init]
        defaultBranch = main
[diff]
        algorithm = histogram
        colorMoved = plain
        mnemonicPrefix = true
        renames = true
[push]
        default = simple
        autoSetupRemote = true
        followTags = true
[fetch]
        prune = true
        pruneTags = true
        all = true
[help]
        autocorrect = prompt
[commit]
        verbose = true
[rerere]
        enabled = true
        autoupdate = true
[core]
	excludesfile = ~/.gitignore_global
	precomposeUnicode = true
	untrackedCache = true
	fsmonitor = false
  pager = delta
[rebase]
        autoSquash = true
        autoStash = true
        updateRefs = true

[include]
  path = ~/.gitconfig.local

[interactive]
  diffFilter = delta --color-only

[delta]
  syntax-theme = "base16"
  line-numbers = true
  navigate = true

[merge]
  conflictstyle = zdiff3

# Credentials Should _normally_ be configured via ~/.gitconfig.local
#[credential "https://github.com"]
# helper = !/usr/bin/gh auth git-credential
#[credential "https://github.rbx.com"]
# helper = !/usr/bin/gh auth git-credential
#[credential]
# helper = /usr/local/share/gcm-core/git-credential-manager
#[credential "https://dev.azure.com"]
#	useHttpPath = true

# fsmonitor is a per-repo background daemon that only pays off on large repos.
# Default is off (see [core] above) to avoid a ~1s daemon cold-start on small
# repos; re-enable it only for the large repos below. Trailing "/" matches all
# worktrees under a bare (.bare) layout. See universal/.config/git/fsmonitor-on.inc.
[includeIf "gitdir:~/GitHub/roblox/groups/"]
	path = ~/.config/git/fsmonitor-on.inc
[includeIf "gitdir:~/GitHub/roblox/game-engine/"]
	path = ~/.config/git/fsmonitor-on.inc
[includeIf "gitdir:~/GitHub/roblox/web-frontend/"]
	path = ~/.config/git/fsmonitor-on.inc
[user]
	email = aciarlillo@roblox.com
	name = Alexander Ciarlillo
[credential "https://github.rbx.com"]
	helper = !/usr/bin/gh auth git-credential
