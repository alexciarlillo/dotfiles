[alias]
  ca = commit --amend --reuse-message=HEAD
	clone-wt = "!sh $HOME/.local/bin/clone-for-wt"
	clean-wt = "!sh $HOME/.local/bin/clean-merged-wt"

[filter "lfs"]
	process = git-lfs filter-process
	required = true
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f

[url "https://"]
    insteadOf = git://

# https://blog.gitbutler.com/how-git-core-devs-configure-git
[column]
  ui = auto
[branch]
        sort = -committerdate
[tag]
        sort = version:refname
[init]
        defaultBranch = main
[diff]
        algorithm = histogram
        colorMoved = plain
        mnemonicPrefix = true
        renames = true
[push]
        default = simple
        autoSetupRemote = true
        followTags = true
[fetch]
        prune = true
        pruneTags = true
        all = true
[help]
        autocorrect = prompt
[commit]
        verbose = true
[rerere]
        enabled = true
        autoupdate = true
[core]
	excludesfile = ~/.gitignore_global
	precomposeUnicode = true
	untrackedCache = true
	fsmonitor = true
  pager = delta
[rebase]
        autoSquash = true
        autoStash = true
        updateRefs = true

[include]
  path = ~/.config/delta/themes/catppuccin.gitconfig
  path = ~/.gitconfig.local

[interactive]
  diffFilter = delta --color-only

[delta]
  features = catppuccin-mocha
  navigate = true
  line-numbers-left-format = ""
  line-numbers-right-format = "│ "

[merge]
  conflictstyle = zdiff3
