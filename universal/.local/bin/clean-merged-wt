#!/usr/bin/env bash
set -euo pipefail

RED="\033[0;31m"
GREEN="\033[0;32m"
YELLOW="\033[0;33m"
CLEAR="\033[0m"

die() {
  printf '%b%s%b\n' "$RED" "$1" "$CLEAR" >&2
  exit 1
}

warn() {
  printf '%b%s%b\n' "$YELLOW" "$1" "$CLEAR" >&2
}

info() {
  printf '%s\n' "$1" >&2
}

success() {
  printf '%b%s%b\n' "$GREEN" "$1" "$CLEAR" >&2
}

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

usage() {
  cat <<EOF
Remove local worktrees whose branches look "done" — either merged into origin's primary branch or
whose remote tracking branch disappeared after pruning (squash merges + deleting the PR branch).

Intended for the bare-hub layout from clone-for-wt (directory with .bare/ and sibling worktrees).

You can run this from:

  • A hub directory (contains .bare/ and .git pointing at it): only that hub is cleaned; or

  • A parent directory holding one hub per subdirectory (each child has .bare/ + .git): every hub is cleaned.

Confidence ladder (evaluated in order, after fetching unless -q):

  CONFIDENT — worktree removed:
    1. Branch tip reachable from origin/<primary> ("git branch --merged").
    2. Branch's cumulative diff already in origin/<primary> — a clean squash/rebase merge,
       detected locally by patch-id (no network). Catches the squash-merge-then-delete flow.
    3. gh reports a merged PR for the branch (only when upstream is "gone"; auto if gh is
       installed + authenticated; disable with --no-verify-remote).

  RISKY — SKIPPED by default (removed only with --force):
    4. Upstream is "gone" but the branch's changes were NOT found in origin/<primary>, and gh
       could not confirm a merge (offline, disabled, or reports no merged PR). This is the
       abandoned / force-deleted case. The unique-commit count and shortlog are printed so you
       can see exactly what would be lost.

  SKIPPED:
    5. No upstream and not merged (typically never-pushed locals).

Note: prior to this ladder, "upstream gone" alone removed the worktree unconditionally. That is
now the RISKY bucket (skip + warn) so abandoned branches are never deleted silently — use --force
(or the gh tier) to remove them.

Options:
  -n, --dry-run           Show what would be removed; make no changes
  -f, --force             Force-remove worktrees / delete branches even with local changes, AND
                          remove RISKY (upstream-gone, unverified) worktrees instead of skipping them
  -q, --no-fetch          Skip "git fetch origin --prune" before comparing (stale refs; may miss
                          freshly deleted remotes)
      --verify-remote     Use gh to confirm PR merge state for upstream-gone branches (default: on
                          when gh is present)
      --no-verify-remote  Never call gh; rely on local detection only (offline / sandbox)

If no directory argument is given, the current directory is used as the hub or parent-of-hubs.

Examples:
  _worktree-cleanup-merged ~/src              # scan ~/src/repo-a, ~/src/repo-b, ...
  _worktree-cleanup-merged -n ~/src/my-repo   # dry-run inside or pointing at one hub

EOF
  exit "${1:-0}"
}

LONG_FETCH=1
DRY_RUN=0
FORCE=0
VERIFY_REMOTE=1
POSITIONAL=()

while [ $# -gt 0 ]; do
  case "$1" in
    -n | --dry-run) DRY_RUN=1 ;;
    -f | --force) FORCE=1 ;;
    -q | --no-fetch) LONG_FETCH=0 ;;
    --verify-remote) VERIFY_REMOTE=1 ;;
    --no-verify-remote) VERIFY_REMOTE=0 ;;
    -h | --help) usage 0 ;;
    --)
      shift
      POSITIONAL+=("$@")
      break
      ;;
    -*)
      die "Unknown option: $1 (try -h)"
      ;;
    *)
      POSITIONAL+=("$1")
      ;;
  esac
  shift
done

if ((${#POSITIONAL[@]} > 0)); then
  set -- "${POSITIONAL[@]}"
else
  set --
fi

TARGET_ROOT="${1:-.}"
TARGET_ROOT="$(cd "$TARGET_ROOT" && pwd -P)"

is_hub_dir() {
  [ -d "$1/.bare" ] && [ -f "$1/.git" ]
}

get_primary_branch() {
  if git show-ref --verify --quiet refs/remotes/origin/master; then
    echo "master"
  elif git show-ref --verify --quiet refs/remotes/origin/main; then
    echo "main"
  else
    return 1
  fi
}

collect_hubs() {
  local root="$1"
  if is_hub_dir "$root"; then
    echo "$root"
    return 0
  fi
  local found=0
  local d base
  for d in "$root"/*/ ; do
    [ -e "$d" ] || continue
    base="${d%/}"
    if is_hub_dir "$base"; then
      printf '%s\n' "$base"
      found=1
    fi
  done
  if [ "$found" -eq 0 ]; then
    return 1
  fi
}

branch_upstream_track() {
  local branch="$1"
  git for-each-ref --format='%(upstream:track,nobracket)' -- "refs/heads/$branch" | head -n1
}

branch_is_merged_into_origin_primary() {
  local branch="$1" primary="$2"
  git branch --merged "origin/$primary" --format='%(refname:short)' |
    grep -qxF -- "$branch"
}

# Content-based merge detection: synthesize what the branch would look like squashed
# onto its merge-base with origin/<primary>, then ask "git cherry" whether an equivalent
# patch (same patch-id) already exists in origin/<primary>. Catches squash- and
# rebase-merges that "git branch --merged" (ancestry-based) cannot see. Local only.
# Note: only fires on a CLEAN squash — if the merge involved conflict resolution or
# rebase drift the patch-ids differ and this returns non-zero (falls through to the
# risky bucket, where the gh tier can still confirm it).
branch_changes_in_origin_primary() {
  local branch="$1" primary="$2" base tree squashed
  base="$(git merge-base "origin/$primary" "$branch" 2>/dev/null)" || return 1
  tree="$(git rev-parse "$branch^{tree}" 2>/dev/null)" || return 1
  squashed="$(git commit-tree "$tree" -p "$base" -m squash-probe 2>/dev/null)" || return 1
  git cherry "origin/$primary" "$squashed" 2>/dev/null | grep -q '^-'
}

# Detect once per run whether we can ask GitHub. Cached in GH_STATE (empty|yes|no).
GH_STATE=""
gh_can_verify() {
  if [ -z "$GH_STATE" ]; then
    if command -v gh >/dev/null 2>&1 && gh auth status >/dev/null 2>&1; then
      GH_STATE="yes"
    else
      GH_STATE="no"
    fi
  fi
  [ "$GH_STATE" = "yes" ]
}

# 0 = a merged PR exists for this head branch; 1 = no merged PR; 2 = gh error/unreachable.
gh_pr_merged() {
  local branch="$1" out
  out="$(gh pr list --state merged --head "$branch" --json number -q '.[0].number' 2>/dev/null)" ||
    return 2
  [ -n "$out" ]
}

# Idea 3: show what a risky removal would cost — commits on the branch that are not
# individually reachable from origin/<primary>.
print_stakes() {
  local branch="$1" primary="$2" n
  n="$(git rev-list --count "origin/$primary..$branch" 2>/dev/null || echo '?')"
  warn "    ↳ ${n} commit(s) not individually reachable in origin/${primary}:"
  git log --oneline --no-decorate -n 20 "origin/$primary..$branch" 2>/dev/null |
    sed 's/^/        /' >&2 || true
}

# Prints a reason token to stdout and returns a confidence code:
#   0 = confident remove   (merged | squash-merged | gh-merged)
#   2 = risky              (upstream-gone-unverified | gh-abandoned) — skip unless --force
#   1 = not eligible       (skip; no upstream and not merged)
cleanup_reason_or_skip() {
  local branch="$1" primary="$2"
  local track

  if branch_is_merged_into_origin_primary "$branch" "$primary"; then
    printf '%s\n' merged
    return 0
  fi

  if branch_changes_in_origin_primary "$branch" "$primary"; then
    printf '%s\n' squash-merged
    return 0
  fi

  track="$(branch_upstream_track "$branch")"
  if [ "$track" = "gone" ]; then
    if [ "$VERIFY_REMOTE" -eq 1 ] && gh_can_verify; then
      gh_pr_merged "$branch"
      case $? in
        0)
          printf '%s\n' gh-merged
          return 0
          ;;
        1)
          printf '%s\n' gh-abandoned
          return 2
          ;;
        *)
          printf '%s\n' upstream-gone-unverified
          return 2
          ;;
      esac
    fi
    printf '%s\n' upstream-gone-unverified
    return 2
  fi

  return 1
}

cleanup_one_hub() {
  local hub="$1"
  local hub_rp primary wt_path wt_branch wt_dir wt_arg

  hub_rp="$(cd "$hub" && pwd -P)"
  (
    cd "$hub"

    primary="$(get_primary_branch)" ||
      die "[$hub_rp] Could not determine primary branch (no origin/master or origin/main)"

    if [ "${LONG_FETCH}" -eq 1 ]; then
      info "[$hub_rp] Fetching origin (--prune)..."
      git fetch origin --prune >&2 || die "[$hub_rp] git fetch origin --prune failed"

      primary="$(get_primary_branch)" ||
        die "[$hub_rp] Could not determine primary branch after fetch"
    fi

    local path=""
    local branch=""
    flush_worktree() {
      if [ -z "$path" ]; then
        branch=""
        return 0
      fi
      wt_path="$path"
      wt_branch="${branch}"

      path=""
      branch=""

      if [ -z "${wt_branch}" ]; then
        info "[$hub_rp] Skip (detached HEAD): ${wt_path}"
        return 0
      fi

      if [ "${wt_branch}" = "${primary}" ]; then
        return 0
      fi

      if ! wt_real="$(cd "$wt_path" 2>/dev/null && pwd -P)"; then
        warn "[$hub_rp] Skip (missing path?): ${wt_path}"
        return 0
      fi

      case "$wt_real" in
        "$hub_rp" | "$hub_rp"/*) ;;
        *)
          warn "[$hub_rp] Skip (outside hub): ${wt_real}"
          return 0
          ;;
      esac

      wt_dir="${wt_real##*/}"

      if [ "$wt_real" = "$hub_rp" ]; then
        warn "[$hub_rp] Skip (worktree at hub root?): ${wt_real}"
        return 0
      fi

      local why rc
      why="$(cleanup_reason_or_skip "$wt_branch" "$primary")" && rc=0 || rc=$?

      if [ "$rc" -eq 1 ]; then
        info "[$hub_rp] Leave (not eligible — not merged into origin/$primary and upstream not gone): [$wt_branch] $wt_dir"
        return 0
      fi

      wt_arg="${wt_dir}"

      if [ "$rc" -eq 2 ]; then
        case "$why" in
          gh-abandoned)
            warn "[$hub_rp] RISKY: gh reports no merged PR and upstream gone — possibly abandoned: [$wt_branch] $wt_dir"
            ;;
          *)
            warn "[$hub_rp] RISKY: upstream gone but changes NOT found in origin/$primary: [$wt_branch] $wt_dir"
            ;;
        esac
        print_stakes "$wt_branch" "$primary"

        if [ "$FORCE" -ne 1 ]; then
          warn "[$hub_rp] Skipping (re-run with --force to remove anyway): [$wt_branch] $wt_dir"
          return 0
        fi
        warn "[$hub_rp] --force set: removing risky worktree anyway: [$wt_branch] $wt_dir"
      else
        case "$why" in
          merged)
            info "[$hub_rp] Remove worktree (branch merged into origin/$primary): [$wt_branch] $wt_arg"
            ;;
          squash-merged)
            info "[$hub_rp] Remove worktree (changes already in origin/$primary — squash/rebase merge): [$wt_branch] $wt_arg"
            ;;
          gh-merged)
            info "[$hub_rp] Remove worktree (PR merged per gh): [$wt_branch] $wt_arg"
            ;;
          *)
            die "[$hub_rp] Internal error: unexpected cleanup reason: $why"
            ;;
        esac
      fi

      if [ "$DRY_RUN" -eq 1 ]; then
        return 0
      fi

      if [ "$FORCE" -eq 1 ]; then
        "${SCRIPT_DIR}/_worktree-rm" -f "$wt_arg" >&2 ||
          warn "[$hub_rp] _worktree-rm failed for: $wt_arg"
      else
        "${SCRIPT_DIR}/_worktree-rm" "$wt_arg" >&2 ||
          warn "[$hub_rp] _worktree-rm failed for: $wt_arg"
      fi
    }

    local line pref rest wt_list_out
    wt_list_out="$(git worktree list --porcelain 2>/dev/null || true)"
    while IFS= read -r line || [ -n "$line" ]; do
      if [ -z "$line" ]; then
        flush_worktree
        continue
      fi
      pref="${line%% *}"
      rest="${line#"$pref"}"
      rest="${rest# }"
      case "$pref" in
        worktree)
          flush_worktree
          path="$rest"
          ;;
        branch)
          branch="${rest#refs/heads/}"
          ;;
      esac
    done <<< "$wt_list_out"

    flush_worktree
  )

  success "[$hub_rp] Cleanup pass done."
}

hub_list=""
if hub_list="$(collect_hubs "$TARGET_ROOT")"; then
  :
else
  die "No clone-for-wt hubs found under: $TARGET_ROOT (expected .bare/ + .git, or immediate child dirs with that layout)"
fi

merged_label="cleanup merged worktrees (dry-run)" 
[ "$DRY_RUN" -eq 0 ] && merged_label="cleanup merged worktrees"

while IFS= read -r hub; do
  [ -z "$hub" ] && continue
  info "═══ $merged_label: $(basename "$hub") ═══"
  cleanup_one_hub "$hub"
done <<< "$hub_list"

success "All hubs processed."
