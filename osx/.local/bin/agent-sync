#!/usr/bin/env bash
# agent-sync — bidirectionally sync ~/agents with a remote via Unison.
# Safe unattended (launchd): quiet no-op when the remote is unreachable.
set -euo pipefail

export PATH="/opt/homebrew/bin:$HOME/.local/bin:$PATH"

PROFILE="agents"
LOCK_DIR="/tmp/agent-sync.lock"
LOG="$HOME/.local/state/agent-sync.log"

# Per-machine remote, unstowed so it survives dotfiles updates. Defaults keep
# the work devspace working with no conf file present.
REMOTE_HOST="coder-engine"
REMOTE_PATH="/home/coder/agents"
CONF="$HOME/.config/agent-sync.conf"
[ -r "$CONF" ] && . "$CONF"

mkdir -p "$(dirname "$LOG")"
log() { printf '%s agent-sync: %s\n' "$(date '+%Y-%m-%dT%H:%M:%S')" "$1" >>"$LOG"; }

command -v unison >/dev/null 2>&1 || { log "unison not on PATH"; exit 0; }

# Overlap guard (mkdir is atomic; macOS has no flock).
if ! mkdir "$LOCK_DIR" 2>/dev/null; then log "run in progress; skip"; exit 0; fi
trap 'rmdir "$LOCK_DIR" 2>/dev/null || true' EXIT

# Off-VPN / host down => quiet success so launchd doesn't flag failures.
if ! ssh -o BatchMode=yes -o ConnectTimeout=8 "$REMOTE_HOST" true 2>/dev/null; then
  log "remote $REMOTE_HOST unreachable; skip"; exit 0
fi

log "sync start"
# Roots passed here (not in the profile): Unison expands neither ~ nor $HOME in
# a profile. The doubled slash after the host keeps REMOTE_PATH absolute — a
# single slash would make it relative to the remote home.
if unison "$PROFILE" "$HOME/agents" "ssh://$REMOTE_HOST/$REMOTE_PATH" \
    -logfile "$LOG" >>"$LOG" 2>&1; then
  log "sync ok"
else
  log "sync failed (exit $?)"
fi
exit 0
