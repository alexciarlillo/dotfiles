<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.agent-sync</string>
    <key>ProgramArguments</key>
    <array><string>__HOME__/.local/bin/agent-sync</string></array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:__HOME__/.local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
    <key>StartInterval</key><integer>300</integer>
    <key>RunAtLoad</key><true/>
    <key>StandardOutPath</key><string>__HOME__/.local/state/agent-sync.launchd.log</string>
    <key>StandardErrorPath</key><string>__HOME__/.local/state/agent-sync.launchd.log</string>
</dict>
</plist>
